# Toolchain and emulator inputs shared by the workflows. Read by .github/scripts/hos-ci.sh and
# .github/scripts/emulator.sh; a non-empty environment variable of the same name overrides a value here.

# HarmonyOS Command Line Tools build (hvigor, ohpm, codelinter, SDK, hdc and, since 26.0.0, the emulator).
# Archives come from the ErBWs/ohos-sdk GitHub releases unless HOS_CLT_URL_<PLATFORM> points at another
# copy. Each digest pins the archive the workflows were validated with, so a replaced upload fails the job.
HOS_CLT_VERSION=26.0.0.821
HOS_CLT_SHA256_LINUX_X64=0cbdf7ac5c1be1e42694d448ffaee0c0be0ba9a948197e2bc5b61ca5bdc481f2
HOS_CLT_SHA256_MACOS_ARM64=d53802c52d3d0a6a0836333c9e8f2bb73d9f6753d1658185539e2659c46df1ad
HOS_CLT_SHA256_MACOS_X64=760049f063f971d20db2bd3e5c23bc52c15d0748e464124c010c4b556f8f95e9
HOS_CLT_MIRROR=https://github.com/ErBWs/ohos-sdk/releases/download

# Package registries hvigor and ohpm resolve from.
HOS_NPM_OHOS_REGISTRY=https://repo.harmonyos.com/npm/
HOS_OHPM_REGISTRY=https://repo.harmonyos.com/ohpm/

# x86_64 phone image for the hosted emulator: HarmonyOS 6.0.2 (API 22), image 6.0.0.130.
# URL and digest come from Huawei's SDK manager service (sdkmanager/v7/hos/download) and are served
# by Huawei's CDN without a login.
HOS_IMAGE_URL=https://update.dbankcdn.com/download/data/pub_13/HWHOTA_hota_900_9/f3/v3/WTj_Mn3DTaGCq-nYBh-_JQ/system-image-phone_all-x86.zip
HOS_IMAGE_SHA256=daf9c651a2503ddd5a0ef2d24cda6b7bc4264afb122f8ac9d078eb3efa4db62b
